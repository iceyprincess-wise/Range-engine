# Mockup (vite) dev server. Both PORT and BASE_PATH are required by vite.config.ts.
PORT=5173
BASE_PATH=/

# API base for the browser. Empty = same origin: vite proxies /api to
# http://127.0.0.1:5000 (the api-server). Point at a deployed api-server
# URL when the mockup is served without that proxy.
VITE_API_BASE=
