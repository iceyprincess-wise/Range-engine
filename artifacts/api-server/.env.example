# BasketAPI secrets should be stored in Render environment variables.
# Do not commit real API keys to source control.

RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=basketapi1.p.rapidapi.com

# Port the api-server listens on. The mockup's vite dev server proxies
# /api to http://127.0.0.1:5000 (see artifacts/mockup-sandbox/vite.config.ts),
# so local dev needs PORT=5000; Render injects its own PORT.
PORT=5000

# Optional: log verbosity (debug|info|warn|error). Defaults to info.
LOG_LEVEL=info

# Optional: override the warehouse data directory (store.json, quota.json,
# games-cache.json). Defaults to <api-server>/data, resolved from the
# server's working directory or install location.
# DATA_DIR=/path/to/data
